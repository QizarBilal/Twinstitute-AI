# ============================================
# PRODUCTION ENVIRONMENT TEMPLATE
# ============================================
# Copy this file to .env.production and fill in actual values
# NEVER commit .env.production to git
# NEVER expose these values publicly

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL="mongodb+srv://username:password@cluster.xxxxx.mongodb.net/twinstitute?retryWrites=true&w=majority&appName=TwinInstituteAI"

# ============================================
# NEXTAUTH CONFIGURATION
# ============================================
NEXTAUTH_URL="https://yourdomain.com"
NEXTAUTH_SECRET="generate-with-node-crypto-randomBytes-32-toString-hex"

# ============================================
# GOOGLE OAUTH 2.0
# ============================================
GOOGLE_CLIENT_ID="xxxxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxx"

# ============================================
# PUBLIC APP CONFIGURATION
# ============================================
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="6Lexxxxxxxxxxxxxxxxxxxx"

# ============================================
# SECURITY - RECAPTCHA
# ============================================
RECAPTCHA_SECRET_KEY="6Lexxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ============================================
# EMAIL CONFIGURATION (SMTP)
# ============================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="noreply@yourdomain.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Twinstitute AI<noreply@yourdomain.com>"

# ============================================
# GROQ AI INTEGRATION
# ============================================
GROQ_ORIENTATION_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxx"
GROQ_ORIENTATION_MODEL="llama3-70b-8192"
GROQ_ORIENTATION_TEMPERATURE="0.4"

GROQ_ROADMAP_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxx"

GROQ_SKILL_GENOME_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxx"

GROQ_AI_MENTOR_BACKUP_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxx"

GROQ_CAREER_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxx"

GROQ_RESUME_BUILDER_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxx"

GROQ_MENTOR_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxx"

GROQ_RECRUITER_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxx"
